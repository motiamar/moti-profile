# Copy this file to .env and fill in the values.
# .env is gitignored — never commit the real file.

# Required: your OpenAI API key
OPENAI_API_KEY=sk-...

# Required for production: URL of the deployed static frontend (used for CORS).
# Example: https://your-portfolio.netlify.app
#          https://username.github.io/LinkdinBot
FRONTEND_URL=
