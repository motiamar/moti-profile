# Copy this file to .env.local for local development (Vite loads .env.local automatically).
# For production builds (GitHub Pages / Netlify), set VITE_API_BASE_URL as a CI/CD secret.
# IMPORTANT: only variables prefixed with VITE_ are exposed to the browser.

# URL of the backend API.
# Local dev:    http://localhost:3000
# Production:   https://your-backend.onrender.com
VITE_API_BASE_URL=http://localhost:3000
